                "path": "app\/Http\/Controllers\/BenchmarkController.php",
                "content": "<?php\n\nnamespace App\\Http\\Controllers;\n\nuse Illuminate\\Http\\Request;\nuse App\\Models\\{Order, Product, Category, User, Review};\n\nclass BenchmarkController extends Controller\n{\n    public function orders()\n    {\n        return Order::all()->map(fn ($o) => [\n            'id' => $o->id,\n            'user' => $o->user->name,           \/\/ N+1\n            'items_count' => $o->items->count(),\/\/ N+1\n        ]);\n    }\n\n    public function orderShow(Order $order)\n    {\n        return [\n            'id' => $order->id,\n            'user' => $order->user->name,\n            'items' => $order->items->map(fn ($item) => [\n                'product' => $item->product->label, \/\/ N+1 per item\n            ]),\n        ];\n    }\n\n    \/\/ \u0627\u0644\u062d\u0627\u0644\u0629 \u0627\u0644\u0642\u0635\u0648\u0649: \u0637\u0644\u0628 \u0627\u0644\u0645\u0624\u0633\u0633\u0629 \u0628\u0640 120 \u0639\u0646\u0635\u0631\n    public function enterpriseOrder()\n    {\n        $order = Order::where('number', 'ENT-00001')->firstOrFail();\n        return [\n            'id' => $order->id,\n            'items' => $order->items->map(fn ($item) => [\n                'product' => $item->product->label, \/\/ 120x N+1\n            ]),\n        ];\n    }\n\n    public function products()\n    {\n        return Product::all()->map(fn ($p) => [\n            'label' => $p->label,\n            'category' => optional($p->category)->label, \/\/ N+1\n        ]);\n    }\n\n    public function productsByCategory(Category $category)\n    {\n        return Product::where('category_id', $category->id)->get();\n    }\n\n    public function productReviews(Product $product)\n    {\n        return $product->reviews->map(fn ($r) => [\n            'rating' => $r->rating,\n            'user' => $r->user->name, \/\/ N+1\n        ]);\n    }\n\n    \/\/ \u062d\u0627\u0644\u0629 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0641\u0626\u0629 \u0627\u0644\u0641\u0627\u0631\u063a\u0629\n    public function productsWithoutCategory()\n    {\n        return Product::whereNull('category_id')->get();\n    }\n\n    public function categoryProducts(Category $category)\n    {\n        return $category->products->map(fn ($p) => [\n            'label' => $p->label,\n            'reviews_count' => $p->reviews->count(), \/\/ N+1\n        ]);\n    }\n\n    public function userOrders(User $user)\n    {\n        return $user->orders->map(fn ($o) => [\n            'number' => $o->number,\n            'items_count' => $o->items->count(), \/\/ N+1\n        ]);\n    }\n\n    public function recentReviews()\n    {\n        return Review::latest()->take(20)->get()->map(fn ($r) => [\n            'product' => $r->product->label, \/\/ N+1\n            'user' => $r->user->name,        \/\/ N+1\n        ]);\n    }\n}\n"
